# Скопируй этот файл в .env и впиши свои значения.
# .env в git НЕ попадает (см. .gitignore). Сюда токены НЕ пишем.

# Токен бота от BotFather (используй НОВЫЙ, перевыпущенный через /revoke)
BOT_TOKEN=

# Твой telegram_id (узнать у @userinfobot) — кому доступны админ-команды
# (/provider, /users, /export, /sources и т.п.).
ADMIN_TELEGRAM_ID=

# Ещё админы (например, товарищ) — их telegram_id через запятую. ADMIN_TELEGRAM_ID
# выше входит в список автоматически, дублировать его тут не нужно.
# ADMIN_TELEGRAM_IDS=111111111,222222222

# Chat ID группы для уведомлений о новых пользователях.
# Как получить: добавь бота в группу, отправь любое сообщение в группу,
# посмотри в логах (journalctl -u cueme-bot) строку с chat_id этого
# сообщения — это отрицательное число вида -1001234567890.
ADMIN_GROUP_CHAT_ID=

# Свои тестовые аккаунты (username без @, через запятую) — /start с них НЕ
# шлёт уведомление о новом пользователе в админ-группу.
# TEST_ACCOUNT_USERNAMES=maryamul4

# Фото-инструкция по подключению (крепится к единственному стартовому
# сообщению /start). Приоритет: сначала ONBOARDING_PHOTO_PATH, если пусто —
# ONBOARDING_PHOTO_FILE_ID.
#
# ONBOARDING_PHOTO_PATH — путь к картинке прямо на сервере (закинуть по
# SCP/SFTP, в обход git, бинарники в репозиторий не коммитим).
ONBOARDING_PHOTO_PATH=
# ONBOARDING_PHOTO_FILE_ID — file_id, если фото уже когда-то отправляли боту.
# Получить: пришли фото боту от ADMIN_TELEGRAM_ID — он ответит готовым file_id.
ONBOARDING_PHOTO_FILE_ID=

# Ссылка на пост в канале с инструкцией по JSON-экспорту (показывается юзеру
# без контактов). Пока поста нет — ведёт на канал целиком.
# ONBOARDING_JSON_POST_URL=https://t.me/CueMee

# ── LLM-провайдеры (каскад: Gemini → Groq → Cloudflare → Cerebras → Mistral →
#    GitHub Models → OpenRouter) ─────────────────────────────────────────────
# Достаточно хотя бы одного ключа, но лучше задать несколько — тогда при лимите
# одного провайдера бот автоматически переключится на следующий. Cloudflare,
# Cerebras, Mistral и GitHub Models опциональны (бесплатные тиры, добавлены
# как доп. фолбэк, чтобы меньше упираться в общие лимиты Gemini/Groq) — не
# заданы, каскад просто пропускает их без ошибки.

# Gemini — основной. Ключ из https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Мультиаккаунтинг Gemini (опционально): несколько ключей через запятую —
# код перебирает их по кругу, чтобы меньше упираться в RPM-лимит одного ключа.
# ВАЖНО: помогает только если ключи из РАЗНЫХ гугл-аккаунтов — если у Google
# лимит висит на уровне аккаунта/проекта, несколько ключей ОДНОГО аккаунта
# его не обойдут. Если не задано — используется один GEMINI_API_KEY выше.
# GEMINI_API_KEYS=ключ_с_первого_аккаунта,ключ_со_второго_аккаунта

# Прокси ТОЛЬКО для Gemini — нужен там, где его API заблокирован по гео (напр. РФ).
# Формат: http://HOST:PORT или socks5://HOST:PORT. Пусто = ходить напрямую.
# Пример для локального VPN-клиента (v2rayN и т.п.): http://127.0.0.1:10809
GEMINI_PROXY=

# Groq — запасной 1. Ключ из https://console.groq.com/keys
# (LLM_API_KEY поддерживается как старый алиас GROQ_API_KEY)
GROQ_API_KEY=

# Мультиаккаунтинг Groq (опционально), та же логика, что у GEMINI_API_KEYS выше —
# помогает только с ключами из РАЗНЫХ аккаунтов Groq. Если не задано — один GROQ_API_KEY.
# GROQ_API_KEYS=ключ_с_первого_аккаунта,ключ_со_второго_аккаунта

# Cloudflare Workers AI — запасной 2, бесплатный тир (~10 000 нейронов/день,
# примерно 1300 LLM-ответов/день — самый ёмкий из бесплатных фолбэков).
# Нужны ОБА значения:
# - CLOUDFLARE_ACCOUNT_ID — Cloudflare Dashboard → правый сайдбар (Account ID)
# - CLOUDFLARE_API_TOKEN — My Profile → API Tokens → Create Token →
#   шаблон "Workers AI" (или Custom Token с правом Account.Workers AI: Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cerebras — запасной 3, бесплатный тир. Ключ из https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Mistral (La Plateforme) — запасной 4, бесплатный тир. Ключ из https://console.mistral.ai
MISTRAL_API_KEY=

# GitHub Models — запасной 5, бесплатный тир от обычного GitHub-аккаунта.
# Fine-grained Personal Access Token с правом "models: read only":
# GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
GITHUB_MODELS_TOKEN=

# OpenRouter — запасной 6. Ключ из https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Необязательные настройки ─────────────────────────────────────────────────
# Порог накопления сообщений для авто-пересборки карточек (по умолчанию 50)
# REBUILD_THRESHOLD=50
# Размер выборки сообщений для LLM-анализа (по умолчанию 150)
# SAMPLE_SIZE=150

# ── Подписка (Tribute) ────────────────────────────────────────────────────────
# Приватный канал-пропуск: Tribute добавляет/убирает участников по оплате,
# бот только проверяет членство. ID канала (вида -100...) — Telegram Desktop:
# правая кнопка по каналу → Copy Link/ID, или через @userinfobot переслав пост
# из канала. Бота нужно добавить в канал АДМИНОМ, иначе get_chat_member не сработает.
PREMIUM_CHANNEL_ID=
# Ссылка на оформление подписки (со страницы канала в Tribute) — показываем в пейволле.
PREMIUM_SUBSCRIBE_URL=
# Бесплатных попыток (Переписать/Ответить за меня/По скриншоту) до пейволла.
# FREE_TRIAL_REQUESTS=5
# Кэш проверки членства в канале, сек — чтобы не дёргать Telegram API на каждое сообщение.
# PREMIUM_CACHE_TTL=300

# ── Оплата Telegram Stars (второй способ, параллельно Tribute) ─────────────────
# Ключа/токена не нужно — currency=XTR, provider_token="". Цены в Stars,
# меняются без деплоя (просто переменной), но дефолты уже разумные.
# STAR_PRICE_DAY=15
# STAR_PRICE_WEEK=60
# STAR_PRICE_MONTH=175
